        level=logging.INFO,
        format='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
    )

    print("=" * 60)
    print("PDF板块切割器测试")
    print("=" * 60)

    if len(sys.argv) > 1:
        pdf_path = sys.argv[1]

        if not Path(pdf_path).exists():
            print(f"\n错误: PDF文件不存在: {pdf_path}")
            sys.exit(1)

        print(f"\n测试PDF: {Path(pdf_path).name}")

        # 1. 创建OCR引擎
        print("\n[1] 创建OCR引擎...")
        ocr_engine = create_ocr_engine()

        # 2. 创建板块切割器
        print("\n[2] 创建板块切割器...")
        splitter = create_section_splitter(
            ocr_engine,
            output_dir='test_output/section_split',
            save_images=True
        )

        # 3. PDF转图片
        print("\n[3] PDF转图片...")
        images = pdf_to_images(pdf_path, dpi=600, save_images=False)
        print(f"  转换了 {len(images)} 页")

        # 4. 处理第一页
        print("\n[4] 处理第一页...")
        pdf_name = Path(pdf_path).stem
        result = splitter.process_pdf_image(images[0], pdf_name)

        # 5. 显示结果
        print("\n[5] 处理结果:")
        print(f"  输出目录: {result['output_dir']}")
        print(f"  头部数据: {result['header_data']}")
        print(f"  板块数量: {len([b for b in result['section_boundaries'].values() if b])}")
        print(f"  尾部数据: {result['footer_data']}")

    else:
        print("\n用法: python pdf_section_splitter.py <PDF文件路径>")
        print("示例: python pdf_section_splitter.py PdfData/MP_12032024_statement_summary.pdf")

    print("\n" + "=" * 60)
    print("测试完成")
    print("=" * 60)
